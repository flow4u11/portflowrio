# Server-only settings. Never prefix these keys with VITE_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_server_only_key
# Legacy service_role JWTs are also supported under SUPABASE_SERVICE_ROLE_KEY.
# Local development without Supabase uses .data/visits.json.
# VISITS_DATA_FILE=.data/visits.json

# Optional Nagi AI. Leave disabled until a provider and durable limiter are ready.
# Never use VITE_ prefixes or put these values in source.
NAGI_AI_ENABLED=0
AI_GATEWAY_API_KEY=
# Choose an available model from your Gateway catalog; no model is selected by default.
NAGI_MODEL=
NAGI_REDIS_REST_URL=
NAGI_REDIS_REST_TOKEN=
